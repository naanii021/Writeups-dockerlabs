---
import { SITE } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border)] py-8 text-sm text-[var(--muted)]">
  <div class="container-page flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
    <p>© {year} {SITE.author}. Construido con Astro.</p>
    <div class="flex gap-4">
      <a href={SITE.github} rel="me noreferrer" target="_blank">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>
