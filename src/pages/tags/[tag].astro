---
import type { CollectionEntry } from 'astro:content';
import WriteupCard from '../../components/writeups/WriteupCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedWriteups, slugify } from '../../utils/content';

export async function getStaticPaths() {
  const writeups = await getPublishedWriteups();
  const tagMap = new Map<string, { label: string; writeups: CollectionEntry<'writeups'>[] }>();

  writeups.forEach((writeup) => {
    writeup.data.tecnicas.forEach((label) => {
      const tag = slugify(label);
      const current = tagMap.get(tag) ?? { label, writeups: [] };
      current.writeups.push(writeup);
      tagMap.set(tag, current);
    });
  });

  return [...tagMap].map(([tag, props]) => ({ params: { tag }, props }));
}

interface Props {
  label: string;
  writeups: CollectionEntry<'writeups'>[];
}

const { label, writeups } = Astro.props;
---

<BaseLayout title={`Técnica: ${label}`} description={`Writeups que utilizan la técnica ${label}.`}>
  <header class="container-page pb-10 pt-14 sm:pt-20">
    <p class="eyebrow">Técnica</p>
    <h1 class="mt-3 font-mono text-4xl font-bold sm:text-5xl">#{slugify(label)}</h1>
    <p class="mt-4 text-[var(--muted)]">{writeups.length} resultado{writeups.length === 1 ? '' : 's'}</p>
  </header>
  <section class="container-page grid gap-5 pb-20 md:grid-cols-2 lg:grid-cols-3">
    {writeups.map((writeup) => <WriteupCard writeup={writeup} />)}
  </section>
</BaseLayout>
