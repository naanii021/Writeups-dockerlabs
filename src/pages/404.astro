---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La ruta solicitada no existe.">
  <section class="container-page section-space max-w-3xl text-center">
    <p class="font-mono text-8xl font-bold text-[var(--accent)]">404</p>
    <h1 class="mt-5 font-mono text-3xl font-bold">Objetivo fuera de alcance</h1>
    <p class="mt-4 text-[var(--muted)]">La ruta no existe o el writeup sigue siendo un borrador.</p>
    <a class="mt-8 inline-flex rounded-lg bg-[var(--accent)] px-5 py-3 font-mono text-sm font-bold text-[#04100b] no-underline" href="/">
      Volver al inicio
    </a>
  </section>
</BaseLayout>
