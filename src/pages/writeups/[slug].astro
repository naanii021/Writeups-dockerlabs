---
import { render, type CollectionEntry } from 'astro:content';
import Callout from '../../components/mdx/Callout.astro';
import Flag from '../../components/mdx/Flag.astro';
import Terminal from '../../components/mdx/Terminal.astro';
import WriteupLayout from '../../layouts/WriteupLayout.astro';
import { getPublishedWriteups } from '../../utils/content';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const writeups = await getPublishedWriteups();
  return writeups.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'writeups'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingTime = getReadingTime(entry.body ?? '');
---

<WriteupLayout entry={entry} headings={headings} readingTime={readingTime}>
  <Content components={{ Callout, Terminal, Flag }} />
</WriteupLayout>
